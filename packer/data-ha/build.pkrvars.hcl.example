# Copy to build.pkrvars.hcl and review account/region/network/base AMI.
# No AWS keys, DB passwords, cookie, replica keyfile or node identities here.
aws_region         = "ap-northeast-2"
project_name       = "doktori"
vpc_filter_name    = "REPLACE_WITH_BUILD_VPC_NAME_TAG"
subnet_filter_name = "REPLACE_WITH_PUBLIC_BUILD_SUBNET_NAME_TAG"
# Explicit existing IDs can replace Name-tag discovery, without retagging VPCs.
# data_ha_vpc_id    = "vpc-REPLACE_WITH_REVIEWED_ID"
# data_ha_subnet_id = "subnet-REPLACE_WITH_REVIEWED_ID"
data_ha_source_ami = "REPLACE_WITH_REVIEWED_UBUNTU_22_04_ARM64_AMI"
redis_version      = "7.2"
rabbitmq_version   = "4.3"
erlang_version     = "27"
mongodb_version    = "7.0"
alloy_version      = "1.15.0"
