#!/usr/bin/env bash
# Redis node bootstrap for self-managed HA:
# - redis-a starts as the initial writable node
# - redis-c/redis-b start as replicas
# - every node runs Sentinel with quorum 2
set -euo pipefail

log() { echo "[redis-ha] $*" >&2; }

SSM_PREFIX="/${project_name}/${environment}"
AWS_REGION="${aws_region}"
NODE_NAME="${node_name}"
NODE_ROLE="${node_role}"
REDIS_SENTINEL_ENABLED="${redis_sentinel_enabled}"
REDIS_MASTER_NAME="${redis_master_name}"
REDIS_PRIMARY_DNS="${redis_primary_dns}"
REDIS_SENTINEL_QUORUM="${redis_sentinel_quorum}"
REDIS_SENTINEL_NODES="${redis_sentinel_nodes}"
ALLOW_INITIAL_PRIMARY="${allow_initial_primary}"

get_param() {
  local path="$SSM_PREFIX/$1"
  local attempt
  for attempt in $(seq 1 30); do
    if aws ssm get-parameter \
      --region "$AWS_REGION" \
      --cli-connect-timeout 5 \
      --cli-read-timeout 15 \
      --name "$path" \
      --with-decryption \
      --query "Parameter.Value" \
      --output text; then
      return 0
    fi
    log "SSM get-parameter retry $attempt/30 for $path"
    sleep 3
  done
  log "Failed to fetch SSM parameter: $path"
  return 1
}

wait_for_dns() {
  local name="$1"
  until getent hosts "$name" >/dev/null 2>&1; do
    log "waiting for DNS: $name"
    sleep 5
  done
}

REDIS_PASSWORD="$(get_param SPRING_REDIS_PASSWORD)"
if [ -z "$REDIS_PASSWORD" ] || [ "$REDIS_PASSWORD" = "CHANGE_ME" ]; then
  log "SPRING_REDIS_PASSWORD must be injected before Redis bootstrap"
  exit 1
fi

hostnamectl set-hostname "$NODE_NAME"

TOKEN="$(curl -fsS -X PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")"
LOCAL_IPV4="$(curl -fsS -H "X-aws-ec2-metadata-token: $TOKEN" "http://169.254.169.254/latest/meta-data/local-ipv4")"
if ! grep -q " $NODE_NAME" /etc/hosts; then
  echo "$LOCAL_IPV4 $NODE_NAME" >>/etc/hosts
fi

install -m 0750 -o redis -g redis -d /etc/redis

CURRENT_PRIMARY_HOST="$REDIS_PRIMARY_DNS"
CURRENT_PRIMARY_PORT=6379
if [ "$REDIS_SENTINEL_ENABLED" = "true" ]; then
  export REDISCLI_AUTH="$REDIS_PASSWORD"
  DISCOVERED_PRIMARY=false
  IFS=',' read -r -a SENTINEL_NODES <<<"$REDIS_SENTINEL_NODES"
  for _ in $(seq 1 30); do
    declare -A votes=()
    for endpoint in "$${SENTINEL_NODES[@]}"; do
      host="$${endpoint%:*}"
      port="$${endpoint##*:}"
      mapfile -t answer < <(timeout 2 redis-cli --raw -h "$host" -p "$port" \
        SENTINEL get-master-addr-by-name "$REDIS_MASTER_NAME" 2>/dev/null || true)
      if [ "$${#answer[@]}" -eq 2 ] && [[ "$${answer[1]}" =~ ^[0-9]+$ ]]; then
        candidate="$${answer[0]}:$${answer[1]}"
        votes["$candidate"]=$(( $${votes["$candidate"]:-0} + 1 ))
        if [ "$${votes["$candidate"]}" -ge 2 ] && \
            [ "$(timeout 2 redis-cli --raw -h "$${answer[0]}" -p "$${answer[1]}" PING 2>/dev/null || true)" = "PONG" ]; then
          CURRENT_PRIMARY_HOST="$${answer[0]}"
          CURRENT_PRIMARY_PORT="$${answer[1]}"
          DISCOVERED_PRIMARY=true
          break
        fi
      fi
    done
    [ "$DISCOVERED_PRIMARY" = true ] && break
    [ "$ALLOW_INITIAL_PRIMARY" = true ] && break
    sleep 2
  done
  if [ "$DISCOVERED_PRIMARY" != true ] && [ "$ALLOW_INITIAL_PRIMARY" != true ]; then
    log "No agreed reachable primary; refusing to bootstrap an independent Redis writer"
    exit 1
  fi
  # 교체 노드는 a라는 정적 역할 대신 Sentinel이 알려 준 현재 primary를 따른다.
  if [ "$DISCOVERED_PRIMARY" = true ]; then
    NODE_ROLE=replica
    [ "$CURRENT_PRIMARY_HOST" = "$LOCAL_IPV4" ] && NODE_ROLE=primary
  fi
fi

cat >/etc/redis/redis.conf <<EOF
bind 0.0.0.0
protected-mode no
port 6379
supervised systemd
dir /var/lib/redis
appendonly yes
requirepass $REDIS_PASSWORD
masterauth $REDIS_PASSWORD
EOF

if [ "$NODE_ROLE" = "replica" ]; then
  wait_for_dns "$CURRENT_PRIMARY_HOST"
  echo "replicaof $CURRENT_PRIMARY_HOST $CURRENT_PRIMARY_PORT" >>/etc/redis/redis.conf
fi

if [ "$REDIS_SENTINEL_ENABLED" = "true" ]; then
wait_for_dns "$CURRENT_PRIMARY_HOST"
cat >>/etc/redis/redis.conf <<EOF
min-replicas-to-write 1
min-replicas-max-lag 5
EOF
cat >/etc/redis/sentinel.conf <<EOF
bind 0.0.0.0
protected-mode no
port 26379
requirepass $REDIS_PASSWORD
dir /var/lib/redis
sentinel resolve-hostnames yes
sentinel monitor $REDIS_MASTER_NAME $CURRENT_PRIMARY_HOST $CURRENT_PRIMARY_PORT $REDIS_SENTINEL_QUORUM
sentinel auth-pass $REDIS_MASTER_NAME $REDIS_PASSWORD
sentinel sentinel-pass $REDIS_PASSWORD
sentinel down-after-milliseconds $REDIS_MASTER_NAME 5000
sentinel failover-timeout $REDIS_MASTER_NAME 60000
sentinel parallel-syncs $REDIS_MASTER_NAME 1
EOF

chown redis:redis /etc/redis/redis.conf /etc/redis/sentinel.conf
chmod 0640 /etc/redis/redis.conf /etc/redis/sentinel.conf

cat >/etc/systemd/system/redis-sentinel.service <<'EOF'
[Unit]
Description=Redis Sentinel
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/bin/redis-sentinel /etc/redis/sentinel.conf --supervised systemd --daemonize no
User=redis
Group=redis
RuntimeDirectory=redis
RuntimeDirectoryMode=2755

[Install]
WantedBy=multi-user.target
EOF
else
  chown redis:redis /etc/redis/redis.conf
  chmod 0640 /etc/redis/redis.conf
fi

systemctl daemon-reload
systemctl enable redis-server
systemctl restart redis-server
if [ "$REDIS_SENTINEL_ENABLED" = "true" ]; then
  systemctl enable redis-sentinel
  systemctl restart redis-sentinel
fi

install -m 0750 -o root -g alloy -d /etc/alloy
printf "%s" "$REDIS_PASSWORD" >/etc/alloy/redis-password
chown root:alloy /etc/alloy/redis-password
chmod 0640 /etc/alloy/redis-password

cat >/etc/alloy/config.alloy <<EOF
prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "meminfo", "diskstats", "filesystem", "loadavg", "netdev"]
}

prometheus.exporter.redis "redis" {
  redis_addr          = "127.0.0.1:6379"
  redis_password_file = "/etc/alloy/redis-password"
}

discovery.relabel "host_metrics_targets" {
  targets = prometheus.exporter.unix.host.targets
  rule {
    target_label = "job"
    replacement = "data-ha-host"
  }
}
prometheus.scrape "host_metrics" {
  job_name = "data-ha-host"
  targets         = discovery.relabel.host_metrics_targets.output
  forward_to      = [prometheus.relabel.data_common.receiver]
  scrape_interval = "30s"
}

discovery.relabel "redis_metrics_targets" {
  targets = prometheus.exporter.redis.redis.targets
  rule {
    target_label = "job"
    replacement = "redis"
  }
}
prometheus.scrape "redis_metrics" {
  job_name = "redis"
  targets         = discovery.relabel.redis_metrics_targets.output
  forward_to      = [prometheus.relabel.data_common.receiver]
  scrape_interval = "15s"
}

%{ if enable_data_ha_observability && redis_sentinel_enabled ~}
prometheus.exporter.redis "sentinel" {
  redis_addr = "127.0.0.1:26379"
  redis_password_file = "/etc/alloy/redis-password"
}
discovery.relabel "sentinel_metrics_targets" {
  targets = prometheus.exporter.redis.sentinel.targets
  rule {
    target_label = "job"
    replacement = "redis-sentinel"
  }
}
prometheus.scrape "sentinel_metrics" {
  job_name = "redis-sentinel"
  targets = discovery.relabel.sentinel_metrics_targets.output
  scrape_interval = "15s"
  forward_to = [prometheus.relabel.data_common.receiver]
}
%{ endif ~}

prometheus.relabel "data_common" {
  forward_to = [prometheus.remote_write.monitoring.receiver]
  rule {
    replacement  = "${environment}"
    target_label = "env"
  }
  rule {
    replacement  = "redis"
    target_label = "service"
  }
  rule {
    replacement  = "$NODE_NAME"
    target_label = "instance"
  }
  rule {
    replacement = "$NODE_NAME"
    target_label = "node"
  }
  rule {
    replacement = "${project_name}-${environment}-data"
    target_label = "cluster"
  }
  rule {
    replacement  = "$NODE_ROLE"
    target_label = "bootstrap_role"
  }
}

%{ if enable_data_ha_observability ~}
prometheus.exporter.self "agent" {}
discovery.relabel "agent_targets" {
  targets = prometheus.exporter.self.agent.targets
  rule {
    target_label = "job"
    replacement = "data-ha-alloy"
  }
}
prometheus.scrape "agent" {
  job_name = "data-ha-alloy"
  targets = discovery.relabel.agent_targets.output
  scrape_interval = "15s"
  forward_to = [prometheus.relabel.data_common.receiver]
}
loki.source.journal "service_0" {
  matches = "_SYSTEMD_UNIT=redis-server.service"
  max_age = "1h"
  labels = { env = "${environment}", cluster = "${project_name}-${environment}-data", service = "redis", node = "$NODE_NAME", job = "data-ha-logs" }
  forward_to = [loki.write.monitoring.receiver]
}
loki.source.journal "service_1" {
  matches = "_SYSTEMD_UNIT=redis-sentinel.service"
  max_age = "1h"
  labels = { env = "${environment}", cluster = "${project_name}-${environment}-data", service = "redis", node = "$NODE_NAME", job = "data-ha-logs" }
  forward_to = [loki.write.monitoring.receiver]
}
loki.write "monitoring" {
  endpoint { url = ${jsonencode(loki_push_url)} }
}
%{ endif ~}

prometheus.remote_write "monitoring" {
  endpoint {
    url = ${jsonencode(remote_write_url)}
  }
}
EOF

chown root:alloy /etc/alloy/config.alloy
chmod 0640 /etc/alloy/config.alloy
%{ if enable_data_ha_observability ~}
usermod -aG adm,systemd-journal alloy
%{ endif ~}
systemctl enable alloy
systemctl restart alloy

log "Redis HA bootstrap complete for $NODE_NAME ($NODE_ROLE)"
