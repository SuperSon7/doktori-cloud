enable_data_ha_observability = true
# Cumulative third stage. Inspect state and volumes before any future rollout.
enable_redis_ha             = true
enable_rabbitmq_ha          = true
enable_mongodb_ha           = true
allow_redis_initial_primary = false
mongodb_replica_set_name    = "doktori-rs"
ha_ami_ids = {
  redis    = "REPLACE_WITH_REVIEWED_REDIS_AMI_ID"
  rabbitmq = "REPLACE_WITH_REVIEWED_RABBITMQ_4_3_AMI_ID"
  mongodb  = "REPLACE_WITH_REVIEWED_MONGODB_AMI_ID"
}
