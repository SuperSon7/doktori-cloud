{
  "uid": "doktori-data-ha",
  "title": "독토리 데이터 HA 상태",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "수집 상태: 준비된 대상 수",
      "description": "응답·인증과 60초 이내 수집을 함께 본다. 전체 프로세스 중단은 아래 경보에서 확인한다.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "doktori_ha:ready_nodes{env=~\"$env\",cluster=~\"$cluster\"}",
          "legendFormat": "{{node}} {{queue}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "데이터 없음",
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "job",
                "service",
                "Value"
              ]
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": [
              {
                "field": "job",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "기대 대상 수",
      "description": "배포할 단계에 맞춰 별도 inventory를 렌더한다. 지표가 사라져도 기대 수는 남는다.",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prom"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "doktori_ha:expected_nodes{env=~\"$env\",cluster=~\"$cluster\"}",
          "legendFormat": "{{node}} {{queue}}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "데이터 없음",
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "job",
                "service",
                "Value"
              ]
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": [
              {
                "field": "job",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "경보 발생 이력",
      "description": "현재 firing만 조회할 때 0건은 빈 결과다. 수집·룰 로드 정상 여부와 함께 확인한다.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "local-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by(alertname,severity)(ALERTS{env=~\"$env\",cluster=~\"$cluster\",alertstate=\"firing\",team=\"data-ha\"})",
          "legendFormat": "{{alertname}} {{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "데이터 없음",
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
